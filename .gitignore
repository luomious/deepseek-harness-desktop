# ============================================================
# DeepSeek Harness Desktop - .gitignore
# ============================================================

# Electron runtime binaries (released via Release, not tracked)
app/
*.exe
*.dll
*.pak
*.dat
*.bin
locales/

# Temporary files
*.zip
*.7z
extracted/
node_modules/
dist/
# Fault-injection tests for dist patches live in tests/dist/ - the generic `dist/` rule
# above silently ignored them (found 2026-09-24: log-write-guard / projcache-guard /
# json-storage-retry / json-storage-orphan-tmp-sweep tests were ALL untracked, so a fresh
# clone could not verify a single dist patch even though verify-patches.ps1 cites them).
# Re-include that one directory explicitly.
!tests/dist/

# OS
Thumbs.db
.DS_Store

test-plugin/

# Workspace memory (local aid data)
.workbuddy/

# pnpm store (local dependency cache)
.pnpm-store/

# Local dev helper scripts (contain personal paths)
approve-builds.ps1
install-dsh-plugins.ps1

# Temporary packaging/verification script directory
tools/

# DSH web profile local backup (for rollback)
.dsh-web-profile-*/

# dsh-safe-delete recycle area (generated at runtime)
.dsh-trash/

# dsh runtime data
.dsh/

# Local analysis/temp directories
.dsh-analysis/

# External repo clone (separate repo, clone per respective README) 鈥?# keep the super-injector tarball tracked (profile file: dep requires it for fresh clones)
plugins/dsh-routing-suite/*
!plugins/dsh-routing-suite/dsh-external-dsh-super-injector-*.tgz

# Plugin build artifacts (tsdown/tsc output; source in src/)
plugins/*/lib/**/*.d.ts
plugins/*/lib/**/*.map

# Agent presets local copy (runtime in ~/.dsh/.agent-presets)
agent-presets/

# Lifecycle/guard plugins runtime data
dsh-stuck-loop-guard/data/
# 鍛ㄦ湡鑷敓鎴愮洃娴嬫姤鍛婏紙鍐呭闅忔椂闂村彉鍖栵紝涓嶅叆搴擄級
dsh-stuck-loop-guard/REPORT.md
dsh-context-lifecycle/data/

# Lifecycle/guard plugins build artifacts (source in src/)
dsh-stuck-loop-guard/lib/**/*.map
dsh-stuck-loop-guard/lib/**/*.d.ts
dsh-context-lifecycle/lib/**/*.map
dsh-context-lifecycle/lib/**/*.d.ts

# Vendor desktop shell (separate repo, clone per docs/BUILD.md)
vendor/

# Build/runtime caches
.corepack/
.yarn-cache/
.yarn-global/
.electron-cache/
.electron-builder-cache/
_backups/
备份/
# 2026-09-29: 冷备份目录（sessions/profile/AppData，~1.7GB，不入库）
.ref-hairyf/

# Local experiments / secrets / debug logs
cb-hy3-test/
hy3-gateway/
proc-watch.log
spawn-trace.log
patches/wip/
scripts/test-siliconflow-vision.mjs
# _tmp/ = per-session probe / one-off scripts (2026-09-24: 1.3 MB of throwaway probes was
# showing up as an untracked blob in every `git status`; durable scripts belong in scripts/)
_tmp/
# write-shim atomic-staging leftovers
.*.tmpdir/
*.tmpdir/

# Defensive general log/secret rules (no current tracked files affected)
*.log
*.pem
*.key
.env
*.local.env

# Runtime audit data (crashpad-hygiene events; regenerated at runtime, untracked since 2026-09-08)
plugins/dsh-crashpad-hygiene/data/events.jsonl


# Generated diagram artifacts (workspace-local outputs of render_diagram)
diagrams/

# Test-render artifacts (regenerated per test run; not fixtures)
tests/preview/
plugins/dsh-diagram-renderer/tests/preview/

# Local backups of tracked files (keep on disk for rollback, never publish)
outputs/*.bak-*
outputs/*.bak.20*

