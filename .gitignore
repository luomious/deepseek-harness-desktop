# ============================================================
# DeepSeek Harness Desktop - .gitignore
# ============================================================

# Electron runtime binaries (released via Release, not tracked)
app/
*.exe
*.dll
*.pak
*.dat
*.bin
locales/

# Temporary files
*.zip
*.7z
extracted/
node_modules/
dist/

# OS
Thumbs.db
.DS_Store

test-plugin/

# Workspace memory (local aid data)
.workbuddy/

# pnpm store (local dependency cache)
.pnpm-store/

# Local dev helper scripts (contain personal paths)
approve-builds.ps1
install-dsh-plugins.ps1

# Temporary packaging/verification script directory
tools/

# DSH web profile local backup (for rollback)
.dsh-web-profile-*/

# dsh-safe-delete recycle area (generated at runtime)
.dsh-trash/

# dsh runtime data
.dsh/

# Local analysis/temp directories
.dsh-analysis/

# External repo clone (separate repo, clone per respective README) —
# keep the super-injector tarball tracked (profile file: dep requires it for fresh clones)
plugins/dsh-routing-suite/*
!plugins/dsh-routing-suite/dsh-external-dsh-super-injector-*.tgz

# Plugin build artifacts (tsdown/tsc output; source in src/)
plugins/*/lib/**/*.d.ts
plugins/*/lib/**/*.map

# Agent presets local copy (runtime in ~/.dsh/.agent-presets)
agent-presets/

# Lifecycle/guard plugins runtime data
dsh-stuck-loop-guard/data/
# 周期自生成监测报告（内容随时间变化，不入库）
dsh-stuck-loop-guard/REPORT.md
dsh-context-lifecycle/data/

# Lifecycle/guard plugins build artifacts (source in src/)
dsh-stuck-loop-guard/lib/**/*.map
dsh-stuck-loop-guard/lib/**/*.d.ts
dsh-context-lifecycle/lib/**/*.map
dsh-context-lifecycle/lib/**/*.d.ts

# Vendor desktop shell (separate repo, clone per docs/BUILD.md)
vendor/

# Build/runtime caches
.corepack/
.yarn-cache/
.yarn-global/
.electron-cache/
.electron-builder-cache/
_backups/
.ref-hairyf/

# Local experiments / secrets / debug logs
cb-hy3-test/
hy3-gateway/
proc-watch.log
spawn-trace.log
patches/wip/
scripts/test-siliconflow-vision.mjs
# write-shim atomic-staging leftovers
.*.tmpdir/
*.tmpdir/

# Defensive general log/secret rules (no current tracked files affected)
*.log
*.pem
*.key
.env
*.local.env

